{
  "schemaVersion": 1,
  "postEdit": {
    "mode": "disabled",
    "command": null,
    "note": "Init may enable one deterministic local formatter as an argv array after human approval."
  },
  "always": [
    "diff_check"
  ],
  "checks": {
    "diff_check": {
      "command": [
        "git",
        "diff",
        "--check"
      ]
    },
    "adoption_tests": {
      "command": [
        "python3",
        "-m",
        "unittest",
        "tests.test_adopt_mamkin_process"
      ]
    },
    "evolution_audit_tests": {
      "command": [
        "python3",
        "-m",
        "unittest",
        "tests.test_audit_mamkin_evolution"
      ]
    },
    "prompt_contracts": {
      "command": [
        "python3",
        "scripts/validate_prompt_contracts.py"
      ]
    },
    "coordination_contract_tests": {
      "command": [
        "python3",
        "-m",
        "unittest",
        "tests.test_validate_coordination_contracts"
      ]
    },
    "validation_planner_tests": {
      "command": [
        "python3",
        "-m",
        "unittest",
        "tests.test_plan_validation"
      ]
    },
    "model_routing_tests": {
      "command": [
        "python3",
        "-m",
        "unittest",
        "tests.test_model_routing"
      ]
    },
    "template_sync_tests": {
      "command": [
        "python3",
        "-m",
        "unittest",
        "tests.test_sync_mamkin_process"
      ]
    },
    "project_check": {
      "command": null,
      "note": "Set during init when the stack-specific check command is known."
    }
  },
  "rules": [
    {
      "patterns": [
        "docs/templates/active-lanes.json",
        "docs/templates/cross-repo-contract.json",
        "scripts/validate_coordination_contracts.py",
        "tests/test_validate_coordination_contracts.py",
        "docs/templates/project-coordinators.json",
        "docs/templates/coordinator-transfer.json",
        "docs/templates/lane-closeout.json",
        "docs/process/managed-projects.md"
      ],
      "checks": [
        "coordination_contract_tests",
        "prompt_contracts"
      ]
    },
    {
      "patterns": [
        ".agents/skills/mamkin-adopt/**",
        "docs/process/adopt-existing-project.md",
        "docs/process/handoff-packets/adoption.md",
        "scripts/adopt_mamkin_process.py",
        "tests/test_adopt_mamkin_process.py"
      ],
      "checks": [
        "adoption_tests"
      ]
    },
    {
      "patterns": [
        ".mamkin/evolution-capabilities.json",
        "scripts/audit_mamkin_evolution.py",
        "tests/test_audit_mamkin_evolution.py"
      ],
      "checks": [
        "evolution_audit_tests"
      ]
    },
    {
      "patterns": [
        "AGENTS.md",
        ".agents/skills/**",
        ".codex/agents/**",
        ".codex/hooks.json",
        ".codex/hooks/**",
        ".codex/config.toml",
        "docs/process/**",
        "docs/templates/**",
        "evals/**",
        "scripts/validate_prompt_contracts.py"
      ],
      "checks": [
        "prompt_contracts"
      ]
    },
    {
      "patterns": [
        ".mamkin/model-routing.json",
        ".codex/agents/mamkin-economy-*.toml",
        ".codex/agents/mamkin-balanced-*.toml",
        ".codex/agents/mamkin-deep-*.toml",
        ".codex/agents/mamkin-critical-*.toml",
        "docs/process/model-routing.md",
        "scripts/select_model_profile.py",
        "tests/test_model_routing.py"
      ],
      "checks": [
        "model_routing_tests",
        "prompt_contracts"
      ]
    },
    {
      "patterns": [
        ".mamkin/validation-map.json",
        "scripts/plan_validation.py",
        "tests/test_plan_validation.py"
      ],
      "checks": [
        "validation_planner_tests"
      ]
    },
    {
      "patterns": [
        ".mamkin/process-manifest.json",
        ".mamkin/template-owned-files.md",
        ".mamkin/template-version.json",
        "scripts/sync_mamkin_process.py",
        "tests/test_sync_mamkin_process.py"
      ],
      "checks": [
        "template_sync_tests"
      ]
    }
  ],
  "processOnlyPatterns": [
    ".mamkin/**",
    ".agents/**",
    ".codex/**",
    "docs/**",
    "evals/**",
    "features/**",
    "scripts/plan_validation.py",
    "scripts/select_model_profile.py",
    "scripts/adopt_mamkin_process.py",
    "scripts/audit_mamkin_evolution.py",
    "scripts/sync_mamkin_process.py",
    "scripts/validate_prompt_contracts.py",
    "scripts/validate_coordination_contracts.py",
    "tests/__init__.py",
    "tests/test_adopt_mamkin_process.py",
    "tests/test_audit_mamkin_evolution.py",
    "tests/test_plan_validation.py",
    "tests/test_model_routing.py",
    "tests/test_sync_mamkin_process.py",
    "tests/test_validate_coordination_contracts.py",
    "README.md",
    "AGENTS.md"
  ],
  "unknownPathCheck": "project_check"
}
